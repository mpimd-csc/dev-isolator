FROM localhost/dev-isolator-ubuntu:26.04


#
# This default Containerfile works on apt and dnf based distributions.
# Consider removing the blocks not matching your desired distribution.
#

# Base packages for Ubuntu/Debian
RUN if [ -x /usr/bin/apt ]; then \
    apt install --yes build-essential gfortran cmake ninja-build python3-dev python3-pip python3-venv ;\
    fi

# Base packages for Fedora/AlmaLinux
RUN if [ -x /usr/bin/dnf ]; then \
    dnf install -y gcc gcc-gfortran cmake ninja-build python3-devel python3-pip ;\
    fi

# ArchLinux based
RUN if [ -x /usr/sbin/pacman ]; then \
    pacman -Sy --noconfirm gcc gcc-fortran cmake ninja make python python-pip ; \
    fi




