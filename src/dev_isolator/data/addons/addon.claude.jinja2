USER root
RUN if [ -x /usr/bin/apt ]; then \
        apt update && apt install --yes curl ; \
    elif [ -x /usr/bin/dnf ]; then \
        dnf install -y curl ; \
    else  \
        exit 1;  \
    fi
USER {{ username }}
RUN curl -fsSL https://claude.ai/install.sh | bash
USER root
ENV PATH="{{ home_dir }}/.local/bin:${PATH}"
