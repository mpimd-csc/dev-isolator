USER root
RUN if [ -x /usr/bin/apt ]; then \
        apt update && apt install --yes curl ca-certificates git gnupg jq ; \
    elif [ -x /usr/bin/dnf ]; then \
        dnf install -y curl git jq gnupg; \
    elif [ -x /usr/sbin/pacman ]; then \
        pacman -Sy --noconfirm curl git jq gnupg ; \
    else  \
        exit 1;  \
    fi
USER {{ username }}
RUN  curl -fsSL https://opencode.ai/v2/install | bash
USER root
ENV PATH="{{ home_dir }}/.opencode/bin:${PATH}"
